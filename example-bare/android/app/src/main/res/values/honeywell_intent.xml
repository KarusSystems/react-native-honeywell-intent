<?xml version="1.0" encoding="utf-8"?>
<!--
  Bare React Native configuration.

  Expo apps get this file generated by the config plugin at prebuild. In a bare
  project you write it yourself: drop it in app/src/main/res/values/ and the
  native module picks it up by resource name. Every value is optional — omit the
  file entirely and the defaults in the library apply.
-->
<resources>
    <string name="hwi_scan_action" translatable="false">com.hwibareexample.SCAN</string>
    <string name="hwi_scanner" translatable="false">dcs.scanner.imager</string>
    <string name="hwi_profile" translatable="false">DEFAULT</string>
    <string-array name="hwi_enabled_decoders" translatable="false">
        <item>code128</item>
        <item>code39</item>
        <item>qrcode</item>
        <item>ean13</item>
        <item>datamatrix</item>
    </string-array>
</resources>
