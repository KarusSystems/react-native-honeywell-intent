{
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "@karus-systems/react-native-honeywell-intent": ["./src/index"]
    },
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "customConditions": ["react-native-strict-api"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitUseStrict": false,
    "noStrictGenericChecks": false,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    // `node` is needed by the tests that read the Kotlin and plugin sources off
    // disk to check the decoder lists have not drifted apart.
    "types": ["node"],
    "verbatimModuleSyntax": true
  },
  "exclude": ["node_modules", "lib", "plugin", "example", "example-bare", "example-shared"]
}
